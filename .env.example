# ################
# SERVER
# ################

# HTTP_ADDRESS=:8080
# HTTPS_REDIRECT_PORT=80
# ENABLE_HTTP_REDIRECT=TRUE
# NETWORK_TEST_ON_START=TRUE
# INCLUDE_PUBLIC_IP_IN_NAT_1_TO_1_IP=TRUE
# MAX_VIEWERS_PER_STREAM=100

# ################
# SSL
# ################

# USE_SSL=TRUE
# SSL_KEY=./certs/key.pem
# SSL_CERT=./certs/cert.pem

# ################
# AUTHORIZATION
# ################

# LOCAL STREAM PROFILES
# STREAM_PROFILE_PATH=./profiles
# STREAM_PROFILE_POLICY=ANYONE_WITH_RESERVED

# WEBHOOK AUTHORIZATION
# WEBHOOK_URL=http://your-server

# ################
# NOTIFICATIONS
# ################
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# PUBLIC_URL=https://stream.example.com
# NOTIFY_OFFLINE_GRACE_PERIOD=60s
# NOTIFY_STREAM_KEYS=streamkey1,streamkey2

# ################
# CLIPS
# ################
# CLIP_STORAGE_PATH=./clips
# CLIP_BUFFER_DURATION=2m
# CLIP_MAX_DURATION=1m
# CLIP_MAX_DRAFTS=10
# CLIP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# CLIP_S3_BUCKET=my-clips
# CLIP_S3_ACCESS_KEY=
# CLIP_S3_SECRET_KEY=
# CLIP_S3_REGION=eu-central-1
# CLIP_S3_PREFIX=broadcast-box

# ################
# CHAT EMOTES
# ################
# CHAT_EMOTE_PROVIDERS=7tv,bttv,ffz
# CHAT_EMOTES_TWITCH_IDS=streamkey:12345678
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# CHAT_GIF_HOSTS=gifs.example.com,*.giphy.com
# SLINK_INSTANCES=gifs.example.com,other.example.com
# GIPHY_API_KEY=
# GIPHY_HOURLY_LIMIT=90
# GIF_CONTENT_RATING=pg-13

# ################
# SOCIAL STREAM NINJA
# ################
# SSN_SESSION_ID=your-ssn-session
# SSN_STREAM_KEYS=streamkey1,streamkey2
# SSN_VERBOSE=TRUE

# ################
# FRONTEND
# ################

